{
  "name": "thugsred-glasses",
  "productName": "Glasses",
  "version": "0.8.1",
  "description": "THUGSred web security research and debugging proxy",
  "author": "THUGSred <hello@thugs.red>",
  "homepage": "https://glasses.thugs.red",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run native && node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node scripts/smoke.mjs",
    "check": "npm run build -- --current && npm test",
    "dist:mac": "node scripts/package.mjs mac",
    "dist:mac:local": "node scripts/package.mjs mac-local",
    "dist:linux": "node scripts/package.mjs linux",
    "dist:win": "node scripts/package.mjs win",
    "pack": "node scripts/package.mjs dir",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:check": "npm run check && npm audit --audit-level=high",
    "test:packaged": "node scripts/smoke-packaged.mjs",
    "icons": "node scripts/icons.mjs",
    "native": "node scripts/native.mjs",
    "test:recovery": "node scripts/recovery-smoke.mjs",
    "release:all": "node scripts/releases.mjs all",
    "release:windows": "node scripts/releases.mjs win",
    "release:linux": "node scripts/releases.mjs linux",
    "test:community": "node scripts/community-smoke.mjs",
    "version:show": "node scripts/version.mjs show",
    "version:sync": "node scripts/version.mjs sync",
    "version:next": "node scripts/version.mjs next",
    "version:check": "node scripts/version.mjs check",
    "docs:build": "node scripts/documents.mjs"
  },
  "dependencies": {
    "node-forge": "^1.4.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^11.0.1"
    },
    "@electron/universal": {
      "minimatch": "^11.0.1"
    }
  },
  "build": {
    "appId": "red.thugs.glasses",
    "productName": "Glasses",
    "artifactName": "Glasses-${version}-build.${buildNumber}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "plugin-sdk/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "LICENSES/**/*",
      "version.json",
      "build/build-info.json"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "build/native/proxy-helper",
          "to": "proxy-helper"
        }
      ],
      "bundleVersion": "33"
    },
    "linux": {
      "category": "Development",
      "target": [
        "tar.gz",
        "deb"
      ],
      "icon": "build/icon.png",
      "maintainer": "THUGSred <hello@thugs.red>",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null,
    "protocols": [
      {
        "name": "Glasses Community",
        "schemes": [
          "glasses"
        ]
      }
    ],
    "buildNumber": "33"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "desktopName": "red.thugs.glasses.desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawaiipantsu/glasses.git"
  },
  "bugs": {
    "url": "https://github.com/kawaiipantsu/glasses/issues"
  }
}
